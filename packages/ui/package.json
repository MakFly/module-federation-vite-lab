    "./lib/*": "./src/lib/*.ts",
    "./styles/*.css": "./styles/*.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@acme/contracts": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  }
}
